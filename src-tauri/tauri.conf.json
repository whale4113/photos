{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "照片",
  "version": "0.1.0",
  "identifier": "local.photos.rebuilt",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "照片",
        "width": 1280,
        "height": 820,
        "minWidth": 840,
        "minHeight": 580,
        "backgroundColor": "#202020",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; media-src 'self' blob: https://cdn.hubblecontent.osi.office.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Photography",
    "shortDescription": "本地照片图库、查看与编辑",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
